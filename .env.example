# ============================================
# SHOPIFY AI PROXY (recommended for Shopify employees)
# ============================================
# Get your token from: https://proxy.shopify.ai/dashboard/access
ANTHROPIC_API_KEY=your-token-from-proxy.shopify.ai
ANTHROPIC_BASE_URL=https://proxy.shopify.ai/apis/anthropic

# ============================================
# SLACK CONFIGURATION
# ============================================
# Create a Slack app at https://api.slack.com/apps
# See SETUP.md for detailed instructions

# Bot Token (from OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing Secret (from Basic Information > App Credentials)
SLACK_SIGNING_SECRET=your-signing-secret

# Channel ID (right-click channel > View channel details > scroll to bottom)
SLACK_CHANNEL_ID=C0AEH7J3T0B

# ============================================
# OPTIONAL OVERRIDES
# ============================================
# CADENCE_DAYS=3
# GMAIL_LABEL=newsletters
# DEBUG=true
